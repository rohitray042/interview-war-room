# Backend only. Copy to ignored .env and configure locally.
WAR_ROOM_STORAGE_MODE=browser
# Render supplies RENDER_EXTERNAL_URL automatically. For other HTTPS hosts:
# WAR_ROOM_PUBLIC_URL=https://your-hostname
# WAR_ROOM_ACCESS_PASSWORD=configure-a-random-secret-on-the-host
# WAR_ROOM_SERVE_FRONTEND=true
# Only used with WAR_ROOM_STORAGE_MODE=local_sqlite for legacy local installations.
WAR_ROOM_DATABASE_PATH=data/war_room.db
LLM_PROVIDER=gemini
GEMINI_MODEL=
GEMINI_API_KEY=
OPENAI_MODEL=
OPENAI_API_KEY=
